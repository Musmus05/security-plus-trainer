# Normalize line endings: LF in the repository, native on checkout for scripts.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat lockfiles as generated so diffs stay collapsed in review.
package-lock.json linguist-generated=true diff=json

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
